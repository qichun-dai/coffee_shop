print(coffees.columns)

def reject_cookies():
    # Use Firefox options for better stability
    firefox_options = FirefoxOptions()
    
    # Set Firefox preferences to avoid remote errors
    firefox_options.set_preference("remote.enabled", False)
    firefox_options.set_preference("remote.force-local", True)
    firefox_options.set_preference("marionette.enabled", True)
    firefox_options.set_preference("marionette.port", 2828)
    
    # Disable problematic remote features
    firefox_options.set_preference("remote.active-protocols", 0)
    firefox_options.set_preference("fission.autostart", False)
    firefox_options.set_preference("browser.tabs.remote.autostart", False)
    
    # Essential options for stability
    firefox_options.add_argument("--no-sandbox")
    firefox_options.add_argument("--disable-dev-shm-usage")
    firefox_options.add_argument("--width=1920")
    firefox_options.add_argument("--height=1080")
    
    # Disable extensions and plugins for stability
    firefox_options.set_preference("extensions.enabled", False)
    firefox_options.set_preference("plugin.state.flash", 0)
    firefox_options.set_preference("plugin.state.java", 0)
    
    # Set preferences for better scraping
    firefox_options.set_preference("dom.webdriver.enabled", False)
    firefox_options.set_preference("useAutomationExtension", False)
    firefox_options.set_preference("general.useragent.override", "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:91.0) Gecko/20100101 Firefox/91.0")
    
    # Performance optimizations
    firefox_options.set_preference("network.http.connection-timeout", 60)
    firefox_options.set_preference("network.http.response.timeout", 60)
    firefox_options.set_preference("dom.max_script_run_time", 60)
    
    # Disable images and CSS for faster loading
    firefox_options.set_preference("permissions.default.image", 2)  # Block images
    firefox_options.set_preference("permissions.default.stylesheet", 2)  # Block CSS
    
    # Logging suppression
    firefox_options.set_preference("devtools.console.stdout.chrome", False)
    firefox_options.set_preference("browser.dom.window.dump.enabled", False)
    
    # Set environment variables to suppress logging
    os.environ['MOZ_LOG'] = ''
    os.environ['MOZ_LOG_FILE'] = ''
    os.environ['GECKO_DRIVER_LOG'] = 'fatal'
    
    try:
        print("Starting Firefox browser with stable configuration...")
        
        # Try to create Firefox service with custom settings
        from selenium.webdriver.firefox.service import Service as FirefoxService
        
        # Create service with log suppression
        service = FirefoxService(log_path=os.devnull)  # Suppress geckodriver logs
        
        driver = webdriver.Firefox(service=service, options=firefox_options)
        print("Firefox started successfully!")
        
        # Set timeouts
        driver.implicitly_wait(10)
        driver.set_page_load_timeout(60)
        
        # Navigate to Google Maps
        print("Navigating to Google Maps...")
        driver.get("https://maps.google.com")
        print("Successfully loaded Google Maps")

        # Wait for the page to load
        time.sleep(5)

        # Handle cookie consent
        try:
            print("Looking for cookie consent button...")
            wait = WebDriverWait(driver, 15)
            reject_button = wait.until(EC.element_to_be_clickable((By.XPATH, "//button[contains(normalize-space(), 'Alles afwijzen')]")))
            print("Found cookie consent button!")
            reject_button.click()
            print("Clicked reject cookies button")
            time.sleep(3)
        except Exception as e:
            print(f"Cookie button not found (this is normal): {e}")
            
        return driver
        
    except Exception as e:
        print(f"Failed to start Firefox with service: {e}")
        print("Trying basic Firefox configuration...")
        
        # Fallback - basic Firefox without service
        try:
            firefox_basic = FirefoxOptions()
            firefox_basic.add_argument("--width=1920")
            firefox_basic.add_argument("--height=1080")
            firefox_basic.set_preference("dom.webdriver.enabled", False)
            firefox_basic.set_preference("remote.enabled", False)
            
            driver = webdriver.Firefox(options=firefox_basic)
            driver.get("https://maps.google.com")
            time.sleep(5)
            print("Basic Firefox configuration successful!")
            return driver
            
        except Exception as basic_error:
            print(f"Basic Firefox also failed: {basic_error}")
            print("\nTroubleshooting steps:")
            print("1. Make sure Firefox is installed")
            print("2. Download geckodriver from: https://github.com/mozilla/geckodriver/releases")
            print("3. Add geckodriver to your PATH or place in script directory")
            print("4. Try running: 'geckodriver --version' to test installation")
            raise Exception("Unable to start Firefox browser with any configuration")

driver = reject_cookies()


def finding_stars(row_index, link, driver, coffees_df):
    # Wait a bit more for the page to fully load after cookie consent

    driver.get(link)
    time.sleep(3)
    

    print(f"Processing row {row_index}: Searching for aria-label elements in the table...")

    try:
        
        # scroll this element
        scrollable = "/html/body/div[1]/div[3]/div[8]/div[9]/div/div/div[1]/div[2]/div/div[1]"
        
        # Wait for the scrollable element to be present
        wait = WebDriverWait(driver, 10)
        scrollable_element = wait.until(EC.presence_of_element_located((By.XPATH, scrollable)))
        
        print("Scrolling down to load all rating elements...")
        
        # # Method 1: Scroll down multiple times to ensure all content is loaded
        # for scroll_attempt in range(5):  # Scroll 5 times
        #     driver.execute_script("arguments[0].scrollTop += 300;", scrollable_element)
        #     time.sleep(1)  # Wait between scrolls
        #     print(f"Scroll attempt {scroll_attempt + 1}")
        
        # Method 2: Scroll to the bottom of the element
        driver.execute_script("arguments[0].scrollTop = arguments[0].scrollHeight;", scrollable_element)
        time.sleep(2)  # Wait for content to load after scrolling to bottom
        
        print("Finished scrolling, waiting for content to load...")
        
        # Wait for the table to be present first, then find aria-label elements
        wait = WebDriverWait(driver, 10)
        
        # Wait for at least one element with aria-label to be present in the table
        wait.until(EC.presence_of_element_located((By.XPATH, f"{table_xpath}//*[@aria-label]")))
        
        # Now find all elements with aria-label within the specific table
        aria_elements = driver.find_elements(By.XPATH, f"{table_xpath}//*[@aria-label]")
        print(f"Found {len(aria_elements)} elements with aria-label in the table")
        
        for i, element in enumerate(aria_elements):
            aria_label = element.get_attribute("aria-label")
            splited = aria_label.split(",")

            star = splited[0].split()[0]
            number = splited[1].split()[0]

            # Update the original DataFrame using .loc with row index
            coffees_df.loc[row_index, f"{star}"] = int(number)
            print(f"Updated row {row_index}, star {star}: {number}")

        # Print the updated row to verify changes
        print(coffees_df.loc[row_index, ['5', '4', '3', '2', '1']])
            
    except Exception as e:
        print(f"Error finding aria-label elements: {e}")
        

for i, row in coffees.iterrows():  
    finding_stars(i, row['placeUri'], driver=driver, coffees_df=coffees)    
    

coffees.to_csv(CSV_LOCATION_NEW, index=False, encoding='utf-8')

driver.close()
